local flyGyro, flyVel
local function StartMobileSitFly()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    hum.Sit = true

    flyGyro = Instance.new("BodyGyro")
    flyGyro.P = 9e4
    flyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyGyro.CFrame = hrp.CFrame
    flyGyro.Parent = hrp

    flyVel = Instance.new("BodyVelocity")
    flyVel.Velocity = Vector3.zero
    flyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyVel.Parent = hrp

    task.spawn(function()
        while FlyEnabled and char and hum.Health > 0 do
            RunService.RenderStepped:Wait()
            hum.Sit = true

            -- คำนวณทิศทางจากการเดินมือถือ (Joystick Input)
            local moveVector = hum.MoveDirection
            
            -- ตรวจสอบระดับความสูงพื้นด้วย Raycast เพื่อให้แตะติดพื้นตลอดเวลา
            local raycastParams = RaycastParams.new()
            raycastParams.FilterDescendantsInstances = {char}
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude

            local rayResult = workspace:Raycast(hrp.Position, Vector3.new(0, -15, 0), raycastParams)
            local groundY = hrp.Position.Y
            if rayResult then
                groundY = rayResult.Position.Y + 2.5 -- ลอยสูงจากพื้นเล็กน้อยในท่านั่ง
            end

            -- ล็อกแกน Y ให้ขนานติดพื้น แล้วพุ่งไปด้วยความเร็ว FlySpeed
            local targetVelocity = Vector3.new(moveVector.X * FlySpeed, (groundY - hrp.Position.Y) * 10, moveVector.Z * FlySpeed)
            flyVel.Velocity = targetVelocity

            if moveVector.Magnitude > 0 then
                flyGyro.CFrame = CFrame.new(hrp.Position, hrp.Position + Vector3.new(moveVector.X, 0, moveVector.Z))
            else
                flyGyro.CFrame = CFrame.new(hrp.Position, hrp.Position + Camera.CFrame.LookVector * Vector3.new(1, 0, 1))
            end
        end

        if flyGyro then flyGyro:Destroy() end
        if flyVel then flyVel:Destroy() end
        if hum then hum.Sit = false end
    end)
end

