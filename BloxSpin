FOVCircle.Visible = false

local SnapLinesPool = {}
local function GetSnapLine(index)
    if not SnapLinesPool[index] then
        local line = Drawing.new("Line")
        line.Transparency = 1
        line.Visible = false
        SnapLinesPool[index] = line
    end
    return SnapLinesPool[index]
end

local function HideAllSnapLines()
    for _, line in ipairs(SnapLinesPool) do
        line.Visible = false
    end
end

local function GetClosestPlayer()
    local OriginPos = (AimMode == "Camera") and UserInputService:GetMouseLocation() or Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local ClosestPlayer = nil
    local ShortestDistance = FOVRadius

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild(TargetPart) and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local ScreenPos, OnScreen = Camera:WorldToViewportPoint(player.Character[TargetPart].Position)
            if OnScreen then
                local Dist = (Vector2.new(ScreenPos.X, ScreenPos.Y) - OriginPos).Magnitude
                if Dist < ShortestDistance then
                    ShortestDistance = Dist
                    ClosestPlayer = player
                end
            end
        end
    end
    return ClosestPlayer
end

-- RenderStepped Main Loop
local hue = 0
local bgRotation = 0

RunService.RenderStepped:Connect(function()
    hue = (hue + 0.005) % 1
    
    bgRotation = (bgRotation + 0.6) % 360
    MainGradient.Rotation = bgRotation
    MiniGradient.Rotation = bgRotation

    Camera.FieldOfView = CameraFOV

    -- ESP Loop Updater
    if ESP_Rainbow then
        ESP_Color = Color3.fromHSV(hue, 1, 1)
    end

    for _, child in pairs(ESPFolder:GetChildren()) do
        if child:IsA("Highlight") then
            child.Enabled = ESP_Enabled
            child.FillColor = ESP_Color
            child.OutlineColor = ESP_Color
        elseif child:IsA("BillboardGui") then
            child.Enabled = ESP_Enabled and ESP_Name_Enabled
        elseif child:IsA("SelectionSphere") then
            child.Visible = ESP_Enabled and ESP_Circle_Enabled
            child.Color3 = ESP_Color
        end
    end

    -- Noclip Loop
    if NoclipEnabled and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    -- Safe Zone Logic
    if SafeZoneEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        
        if hum and hrp and hum.Health > 0 then
            local healthPercent = (hum.Health / hum.MaxHealth) * 100
            if (healthPercent >= 18 and healthPercent <= 19) or IsInSafeZone then
                if not IsInSafeZone then
                    SavedPosition = hrp.CFrame
                    IsInSafeZone = true
                end
                hrp.CFrame = CFrame.new(SavedPosition.Position.X, -200, SavedPosition.Position.Z)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end
    end

    -- SpinBot Logic
    if SpinBotEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and hrp then
            pcall(function()
                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(SpinSpeed), 0)
            end)
        end
    end

    -- Aimbot & FOV Circle Logic
    local CenterScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local CurrentPos = (AimMode == "Camera") and UserInputService:GetMouseLocation() or CenterScreen
    
    FOVCircle.Position = CurrentPos
    FOVCircle.Radius = FOVRadius
    FOVCircle.Visible = AimbotEnabled

    if AimbotEnabled then
        local Target = GetClosestPlayer()
        if Target and Target.Character and Target.Character:FindFirstChild(TargetPart) then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, Target.Character[TargetPart].Position)
        end
    end

    -- SnapLines
    if SnapLinesEnabled then
        local lineIndex = 1
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild(TargetPart) and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
                local TargetWorldPos = player.Character[TargetPart].Position
                local ScreenPos, OnScreen = Camera:WorldToViewportPoint(TargetWorldPos)

                if OnScreen then
                    local line = GetSnapLine(lineIndex)
                    line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    line.To = Vector2.new(ScreenPos.X, ScreenPos.Y)
                    line.Thickness = SnapLineThickness

                    if SnapLineMode == "Rainbow" then
                        line.Color = Color3.fromHSV(hue, 0.9, 1)
                    elseif SnapLineMode == "Gradient" then
                        local dist = (Vector2.new(ScreenPos.X, ScreenPos.Y) - CurrentPos).Magnitude
                        local factor = math.clamp(dist / FOVRadius, 0, 1)
                        line.Color = Color3.fromRGB(255, math.floor(255 * (1 - factor)), 50)
                    else
                        line.Color = Color3.fromRGB(255, 60, 90)
                    end

                    line.Visible = true
                    lineIndex = lineIndex + 1
                end
            end
        end

        for i = lineIndex, #SnapLinesPool do
            SnapLinesPool[i].Visible = false
        end
    else
        HideAllSnapLines()
    end
end)
