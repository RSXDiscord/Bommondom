-- RenderStepped Loops
RunService.RenderStepped:Connect(function()
    FOVCircle.Position = GetFOVCenter()
    FOVCircle.Radius = AimLockSettings.FOV
    FOVCircle.Color = AimLockSettings.FOVColor
    FOVCircle.Visible = AimLockSettings.ShowFOV and (AimLockSettings.Enabled or SilentAimSettings.Enabled)

    if AimLockSettings.Enabled and not IsTouchingScreen then
        local Target = GetClosestTarget()
        if Target then
            local CurrentCF = Camera.CFrame
            local TargetCF = CFrame.new(CurrentCF.Position, Target.Position)
            Camera.CFrame = CurrentCF:Lerp(TargetCF, math.clamp(AimLockSettings.Smoothness, 0.01, 0.2))
        end
    end

    -- Professional ESP Renderer Loop with Safety Checks
    for player, esp in pairs(ESPRegistry) do
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        local head = char and char:FindFirstChild("Head")

        local renderCondition = ESPSettings.Enabled and char and hrp and humanoid and head and humanoid.Health > 0
        if renderCondition then
            local isTeam = (ESPSettings.TeamCheck and player.Team and player.Team == LocalPlayer.Team)
            local currentThemeColor = isTeam and ESPSettings.TeamColor or ESPSettings.EnemyColor
            if not ESPSettings.TeamCheck then currentThemeColor = ESPSettings.BoxColor end

            local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            local distance = (Camera.CFrame.Position - hrp.Position).Magnitude

            if onScreen and distance <= ESPSettings.MaxDistance then
                local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local legPos, legOnScreen = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                
                if headOnScreen and legOnScreen then
                    local height = math.abs(headPos.Y - legPos.Y)
                    local width = height / 2
                    local pos = Vector2.new(vector.X - width / 2, headPos.Y)

                    -- 2D Box / Corner Box / Filled Box
                    if ESPSettings.Box then
                        if ESPSettings.BoxStyle == "2D Box" then
                            esp.Box.Visible = true
                            esp.Box.Size = Vector2.new(width, height)
                            esp.Box.Position = pos
                            esp.Box.Color = currentThemeColor
                            esp.BoxFilled.Visible = false
                        elseif ESPSettings.BoxStyle == "Corner Box" then
                            esp.Box.Visible = true
                            esp.Box.Size = Vector2.new(width, height)
                            esp.Box.Position = pos
                            esp.Box.Color = currentThemeColor
                            esp.BoxFilled.Visible = false
                        elseif ESPSettings.BoxStyle == "Filled Box" then
                            esp.Box.Visible = true
                            esp.Box.Size = Vector2.new(width, height)
                            esp.Box.Position = pos
                            esp.Box.Color = currentThemeColor
                            esp.BoxFilled.Visible = true
                            esp.BoxFilled.Size = Vector2.new(width, height)
                            esp.BoxFilled.Position = pos
                        end
                    else
                        esp.Box.Visible = false
                        esp.BoxFilled.Visible = false
                    end

                    -- Name ESP
                    if ESPSettings.Name then
                        esp.Name.Visible = true
                        esp.Name.Text = player.Name
                        esp.Name.Position = Vector2.new(vector.X, pos.Y - 15)
                        esp.Name.Color = ESPSettings.NameColor
                    else
                        esp.Name.Visible = false
                    end

                    -- Distance ESP
                    if ESPSettings.Distance then
                        esp.Distance.Visible = true
                        esp.Distance.Text = string.format("[%dft]", math.floor(distance))
                        esp.Distance.Position = Vector2.new(vector.X, pos.Y + height + 2)
                        esp.Distance.Color = Color3.fromRGB(200, 200, 200)
                    else
                        esp.Distance.Visible = false
                    end

                    -- Health Bar
                    if ESPSettings.HealthBar then
                        local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                        esp.HealthBarBg.Visible = true
                        esp.HealthBarBg.Size = Vector2.new(3, height + 2)
                        esp.HealthBarBg.Position = Vector2.new(pos.X - 6, pos.Y - 1)

                        esp.HealthBar.Visible = true
                        esp.HealthBar.Size = Vector2.new(1, (height * healthPercent))
                        esp.HealthBar.Position = Vector2.new(pos.X - 5, pos.Y + (height * (1 - healthPercent)))
                        esp.HealthBar.Color = Color3.fromRGB(255 - (healthPercent * 255), healthPercent * 255, 0)
                    else
                        esp.HealthBarBg.Visible = false
                        esp.HealthBar.Visible = false
                    end

                    -- Tracers
                    if ESPSettings.Tracers then
                        esp.Tracer.Visible = true
                        local origin = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        if ESPSettings.TracerOrigin == "Center" then
                            origin = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                        elseif ESPSettings.TracerOrigin == "Mouse" then
                            origin = UserInputService:GetMouseLocation()
                        end
                        esp.Tracer.From = origin
                        esp.Tracer.To = Vector2.new(vector.X, pos.Y + height)
                        esp.Tracer.Color = currentThemeColor
                    else
                        esp.Tracer.Visible = false
                    end

                    -- Skeleton ESP
                    if ESPSettings.Skeleton and char:FindFirstChild("Head") and char:FindFirstChild("UpperTorso") then
                        local joints = {
                            {"Head", "UpperTorso"},
                            {"UpperTorso", "LowerTorso"},
                            {"UpperTorso", "LeftUpperArm"},
                            {"LeftUpperArm", "LeftLowerArm"},
                            {"LeftLowerArm", "LeftHand"},
                            {"UpperTorso", "RightUpperArm"},
                            {"RightUpperArm", "RightLowerArm"},
                            {"RightLowerArm", "RightHand"},
                            {"LowerTorso", "LeftUpperLeg"},
                            {"LeftUpperLeg", "LeftLowerLeg"},
                            {"LeftLowerLeg", "LeftFoot"},
                            {"LowerTorso", "RightUpperLeg"},
                            {"RightUpperLeg", "RightLowerLeg"},
                            {"RightLowerLeg", "RightFoot"}
                        }
                        for i, joint in ipairs(joints) do
                            local p1 = char:FindFirstChild(joint[1])
                            local p2 = char:FindFirstChild(joint[2])
                            local line = esp.SkeletonLines[i]
                            if p1 and p2 and line then
                                local v1, vis1 = Camera:WorldToViewportPoint(p1.Position)
                                local v2, vis2 = Camera:WorldToViewportPoint(p2.Position)
                                if vis1 and vis2 then
                                    line.Visible = true
                                    line.From = Vector2.new(v1.X, v1.Y)
                                    line.To = Vector2.new(v2.X, v2.Y)
                                    line.Color = currentThemeColor
                                else
                                    line.Visible = false
                                end
                            elseif line then
                                line.Visible = false
                            end
                        end
                    else
                        for _, line in ipairs(esp.SkeletonLines) do line.Visible = false end
                    end
                else
                    HideESP(esp)
                end
            else
                HideESP(esp)
            end
        else
            HideESP(esp)
        end
    end

    -- NoClip Engine Loop
    if AdvancedMovementEngine.NoClip and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    -- Universal Cross-Platform Fly Engine Loop (Fixed Camera-locked & Stiff Movement)
    if AdvancedMovementEngine.FlyEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local HRP = LocalPlayer.Character.HumanoidRootPart
        local Hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        local CamCF = Camera.CFrame
        local MoveVector = Vector3.new()

        -- Keyboard Controls
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then MoveVector = MoveVector + CamCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then MoveVector = MoveVector - CamCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then MoveVector = MoveVector - CamCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then MoveVector = MoveVector + CamCF.RightVector end

        -- Mobile / Humanoid MoveDirection Fallback (Works with Thumbstick)
        if Hum and Hum.MoveDirection.Magnitude > 0 then
            local flatLook = Vector3.new(CamCF.LookVector.X, 0, CamCF.LookVector.Z).Unit
            local flatRight = Vector3.new(CamCF.RightVector.X, 0, CamCF.RightVector.Z).Unit
            MoveVector = MoveVector + (flatLook * Hum.MoveDirection.Z + flatRight * Hum.MoveDirection.X)
        end

        if MoveVector.Magnitude > 0 then
            MoveVector = MoveVector.Unit
        end

        HRP.AssemblyLinearVelocity = MoveVector * AdvancedMovementEngine.FlySpeed
        HRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        HRP.CFrame = CFrame.new(HRP.Position, HRP.Position + Vector3.new(CamCF.LookVector.X, 0, CamCF.LookVector.Z))
    end
end)

