-- Metatable Hooks
local gmt = getrawmetatable(game)
local oldIndex = gmt.__index
local oldNamecall = gmt.__namecall
setreadonly(gmt, false)

gmt.__index = newcclosure(function(self, key)
    if not checkcaller() then
        if AdvancedMovementEngine.BypassDetection and self:IsA("Humanoid") then
            if key == "WalkSpeed" and (AdvancedMovementEngine.SpeedEnabled or StealEggSettings.ManualSpeedEnabled) then return 16
            elseif key == "JumpPower" and AdvancedMovementEngine.JumpEnabled then return 50 end
        end

        if SilentAimSettings.Enabled and self == Mouse then
            local Target = GetClosestTarget()
            if Target then
                if key == "Hit" or key == "CFrame" then return Target.CFrame
                elseif key == "Target" then return Target
                elseif key == "UnitRay" then return Ray.new(Camera.CFrame.Position, (Target.Position - Camera.CFrame.Position).Unit) end
            end
        end
    end
    return oldIndex(self, key)
end)

gmt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if not checkcaller() and SilentAimSettings.Enabled then
        if method == "Raycast" then
            local Target = GetClosestTarget()
            if Target then
                args[2] = (Target.Position - args[1]).Unit * 1000
                return oldNamecall(self, unpack(args))
            end
        elseif method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay" then
            local Target = GetClosestTarget()
            if Target then
                args[1] = Ray.new(Camera.CFrame.Position, (Target.Position - Camera.CFrame.Position).Unit * 1000)
                return oldNamecall(self, unpack(args))
            end
        end
    end
    return oldNamecall(self, ...)
end)
setreadonly(gmt, true)

