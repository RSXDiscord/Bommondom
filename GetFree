local TSB_REMOTE_NAME = "DashEvent"

local function TriggerTSBDashServer()
    local dashRemote = ReplicatedStorage:FindFirstChild(TSB_REMOTE_NAME, true) 
        or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(TSB_REMOTE_NAME, true))

    if dashRemote and dashRemote:IsA("RemoteEvent") then
        pcall(function()
            dashRemote:FireServer("Dash", TSBSettings.DashKey)
        end)
    end
end

local tsbCachedTarget = nil
local tsbLastTargetCheck = 0

local function FindTSBGlobalTarget()
    local now = tick()
    if now - tsbLastTargetCheck < 0.1 and tsbCachedTarget and tsbCachedTarget.Parent then
        return tsbCachedTarget
    end
    tsbLastTargetCheck = now

    local Character = LocalPlayer.Character
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then 
        tsbCachedTarget = nil
        return nil 
    end
    
    local RootPart = Character.HumanoidRootPart
    local closest, lastDist = nil, 80 
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Parent ~= Character then
            local isPlayer = Players:GetPlayerFromCharacter(obj.Parent)
            local isDummy = not isPlayer
            local canTarget = (TSBSettings.TargetMode == 1) or (TSBSettings.TargetMode == 2 and isPlayer) or (TSBSettings.TargetMode == 3 and isDummy)
            if canTarget then
                local targetRoot = obj.Parent:FindFirstChild("HumanoidRootPart")
                if targetRoot then
                    local dist = (RootPart.Position - targetRoot.Position).Magnitude
                    if dist < lastDist then 
                        lastDist = dist 
                        closest = targetRoot 
                    end
                end
            end
        end
    end
    tsbCachedTarget = closest
    return closest
end

local function IsPlayingTSBUppercut(Humanoid)
    for _, track in pairs(Humanoid:GetPlayingAnimationTracks()) do
        local id = track.Animation.AnimationId
        if UPPERCUT_ANIM_IDS[id] or UPPERCUT_ANIM_IDS[id:sub(-11)] then
            return true
        end
    end
    return false
end

local function ConnectTSBCharacter(Character)
    local Humanoid = Character:WaitForChild("Humanoid")
    local RootPart = Character:WaitForChild("HumanoidRootPart")

    Humanoid.AnimationPlayed:Connect(function(track)
        local animId = track.Animation.AnimationId
        
        if (animId:find(TSBSettings.TargetAnimId) or animId:find(TSBSettings.QDashId)) then
            if IsPlayingTSBUppercut(Humanoid) then return end

            local target = FindTSBGlobalTarget()
            task.wait(track.Length * 0.30)
            if target and target.Parent then
                if TSBSettings.ZigzagEnabled then
                    task.spawn(TriggerTSBDashServer)
                    local startTime = tick()
                    local connection
                    connection = RunService.Heartbeat:Connect(function()
                        local elapsed = tick() - startTime
                        
                        if IsPlayingTSBUppercut(Humanoid) then
                            connection:Disconnect()
                            return
                        end

                        if target and target.Parent and elapsed < TSBSettings.LockDuration then
                            local tPos = target.Position
                            local sideOffset = math.sin(elapsed * 35) * 6.5
                            local forwardOffset = target.CFrame.LookVector * 1.5
                            local rightOffset = target.CFrame.RightVector * sideOffset
                            
                            RootPart.CFrame = CFrame.new(tPos + forwardOffset + rightOffset, tPos)
                        else
                            connection:Disconnect()
                        end
                    end)
                elseif TSBSettings.TechSubEnabled then
                    task.spawn(TriggerTSBDashServer)
                    local startTime = tick()
                    local connection
                    connection = RunService.Heartbeat:Connect(function()
                        local elapsed = tick() - startTime
                        if target and target.Parent and elapsed < TSBSettings.LockDuration then
                            local tPos = target.Position
                            if elapsed < 0.4 then
                                local sideOffset = math.sin(elapsed * 40) * 7 
                                RootPart.CFrame = CFrame.new(tPos + (target.CFrame.RightVector * sideOffset), tPos)
                            else
                                local camLook = Camera.CFrame.LookVector
                                local warpPos = (camLook.Y < -0.3) and target.Position + (target.CFrame.LookVector * -2.5) or target.Position + (target.CFrame.LookVector * 1.5)
                                RootPart.CFrame = CFrame.new(warpPos, Vector3.new(tPos.X, tPos.Y + 60, tPos.Z))
                            end
                        else
                            connection:Disconnect()
                        end
                    end)
                elseif TSBSettings.NormalEnabled then
                    task.spawn(TriggerTSBDashServer)
                    local startTime = tick()
                    local connection
                    connection = RunService.Heartbeat:Connect(function()
                        if target and target.Parent and (tick() - startTime) < TSBSettings.LockDuration then
                            RootPart.CFrame = CFrame.new(target.Position + (target.CFrame.LookVector * 1.2), Vector3.new(target.Position.X, target.Position.Y + 15, target.Position.Z))
                        else
                            connection:Disconnect()
                        end
                    end)
                end
            end
        elseif (SPIN_ANIM_IDS[animId:sub(-11)] or SPIN_ANIM_IDS[animId]) and TSBSettings.SpinEnabled then
            if tick() - TSBSettings.LastSpin < TSBSettings.SpinDelay then return end
            TSBSettings.LastSpin = tick()
            local target = FindTSBGlobalTarget()
            if target and target.Parent then
                task.spawn(TriggerTSBDashServer)
                local startTime, angle = tick(), 0
                local connection
                connection = RunService.Heartbeat:Connect(function()
                    if target and target.Parent and (tick() - startTime) < TSBSettings.LockDuration then
                        angle = angle + 0.8
                        local offset = Vector3.new(math.cos(angle) * 6, 0, math.sin(angle) * 6)
                        RootPart.CFrame = CFrame.new(target.Position + offset, target.Position)
                    else
                        connection:Disconnect()
                    end
                end)
            end
        end
    end)
end

