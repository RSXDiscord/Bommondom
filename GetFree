local function AddToggle(parent, yPos, text, defaultState, callback)
    local state = defaultState or false
    local Box = Instance.new("TextButton")
    Box.Size = UDim2.new(0, 10, 0, 10)
    Box.Position = UDim2.new(0, 10, 0, yPos)
    Box.BackgroundColor3 = state and Color3.fromRGB(255, 130, 0) or Color3.fromRGB(22, 22, 22)
    Box.BorderColor3 = Color3.fromRGB(60, 60, 60)
    Box.Text = state and "+" or ""
    Box.TextColor3 = Color3.fromRGB(0, 0, 0)
    Box.FontFace = MCFont
    Box.TextSize = 8
    Box.Parent = parent

    local Label = Instance.new("TextButton")
    Label.Size = UDim2.new(0, 120, 0, 10)
    Label.Position = UDim2.new(0, 26, 0, yPos)
    Label.BackgroundTransparency = 1
    Label.Text = text
    Label.TextColor3 = Color3.fromRGB(200, 200, 200)
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.FontFace = MCFont
    Label.TextSize = 9
    Label.Parent = parent

    local function Toggle()
        state = not state
        Tween(Box, 0.15, {BackgroundColor3 = state and Color3.fromRGB(255, 130, 0) or Color3.fromRGB(22, 22, 22)})
        Box.Text = state and "+" or ""
        if callback then callback(state) end
    end

    Box.MouseButton1Click:Connect(Toggle)
    Label.MouseButton1Click:Connect(Toggle)
end

local function AddSlider(parent, yPos, title, min, max, default, callback)
    local SliderText = Instance.new("TextLabel")
    SliderText.Size = UDim2.new(1, -20, 0, 12)
    SliderText.Position = UDim2.new(0, 10, 0, yPos)
    SliderText.BackgroundTransparency = 1
    SliderText.Text = title .. " : " .. tostring(default)
    SliderText.TextColor3 = Color3.fromRGB(160, 160, 160)
    SliderText.TextXAlignment = Enum.TextXAlignment.Left
    SliderText.FontFace = MCFont
    SliderText.TextSize = 8
    SliderText.Parent = parent

    local SliderBg = Instance.new("Frame")
    SliderBg.Size = UDim2.new(1, -20, 0, 6)
    SliderBg.Position = UDim2.new(0, 10, 0, yPos + 14)
    SliderBg.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    SliderBg.BorderColor3 = Color3.fromRGB(40, 40, 40)
    SliderBg.Parent = parent

    local startPercent = math.clamp((default - min) / (max - min), 0, 1)
    local SliderFill = Instance.new("Frame")
    SliderFill.Size = UDim2.new(startPercent, 0, 1, 0)
    SliderFill.BackgroundColor3 = Color3.fromRGB(255, 130, 0)
    SliderFill.BorderSizePixel = 0
    SliderFill.Parent = SliderBg

    local isDragging = false
    local function Update(input)
        local mousePos = input.Position.X
        local bgPos = SliderBg.AbsolutePosition.X
        local bgSize = SliderBg.AbsoluteSize.X
        local percent = math.clamp((mousePos - bgPos) / bgSize, 0, 1)
        local rawValue = min + (max - min) * percent
        local value = (max <= 2) and (math.floor(rawValue * 100) / 100) or math.floor(rawValue)
        Tween(SliderFill, 0.05, {Size = UDim2.new(percent, 0, 1, 0)})
        SliderText.Text = title .. " : " .. tostring(value)
        if callback then callback(value) end
    end

    SliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            Update(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            Update(input)
        end
    end)
end

