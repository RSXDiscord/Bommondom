    Arrow.TextColor3 = Color3.fromRGB(255, 130, 0)
    Arrow.FontFace = MCFont
    Arrow.TextSize = 7
    Arrow.ZIndex = 11
    Arrow.Parent = DropFrame

    local isOpen = false
    local listHeight = #options * 16

    local ListHolder = Instance.new("Frame")
    ListHolder.Size = UDim2.new(1, 0, 0, listHeight)
    ListHolder.Position = UDim2.new(0, 0, 0, 18)
    ListHolder.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
