-- Animated UI Toggle System
local uiVisible = false
local isAnimating = false

local function OpenUI()
    if isAnimating then return end
    isAnimating = true
    uiVisible = true
    MainFrame.Visible = true
    MainFrame.Size = UDim2.new(0, 500, 0, 0)
    MainFrame.Position = UDim2.new(0.5, -250, 0.5, 0)
    
    Tween(MainFrame, 0.35, {
        Size = UDim2.new(0, 500, 0, 310),
        Position = UDim2.new(0.5, -250, 0.5, -155)
    }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    
    task.delay(0.35, function() isAnimating = false end)
end

local function CloseUI()
    if isAnimating then return end
    isAnimating = true
    uiVisible = false
    
    Tween(MainFrame, 0.25, {
        Size = UDim2.new(0, 500, 0, 0),
        Position = UDim2.new(0.5, -250, 0.5, 0)
    }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    
    task.delay(0.25, function()
        MainFrame.Visible = false
        isAnimating = false
    end)
end

local function ToggleMainUI()
    if uiVisible then
        CloseUI()
    else
        OpenUI()
    end
end

ToggleBtn.MouseButton1Click:Connect(ToggleMainUI)

UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == DashboardSettings.MenuKeybind then
        ToggleMainUI()
    end
end)
