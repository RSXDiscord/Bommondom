-- Target Detection System
local function GetTargetCandidates()
    local Candidates = {}
    if AimLockSettings.TargetFilterMode == "All Targets" or AimLockSettings.TargetFilterMode == "Players Only" then
        for _, v in pairs(Players:GetPlayers()) do
            if v ~= LocalPlayer and v.Character then 
                table.insert(Candidates, v.Character) 
            end
        end
    end
    if AimLockSettings.TargetFilterMode == "All Targets" or AimLockSettings.TargetFilterMode == "NPCs / Dummies" then
        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") and v ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(v) then
                table.insert(Candidates, v)
            end
        end
    end
    return Candidates
end

local function GetClosestTarget()
    if not (AimLockSettings.Enabled or SilentAimSettings.Enabled) then return nil end
    local ClosestPart = nil
    local MaxDistance = AimLockSettings.FOV
    local FOVPos = GetFOVCenter()
    local Targets = GetTargetCandidates()

    for _, Model in pairs(Targets) do
        local Humanoid = Model:FindFirstChildOfClass("Humanoid")
        if Humanoid then
            if AimLockSettings.DeathCheck and Humanoid.Health <= 0 then continue end
            local Player = Players:GetPlayerFromCharacter(Model)
            if AimLockSettings.TeamCheck and Player and Player.Team and Player.Team == LocalPlayer.Team then continue end

            local TargetPart = Model:FindFirstChild(AimLockSettings.TargetBone) 
                or Model:FindFirstChild("Head") 
                or Model:FindFirstChild("HumanoidRootPart") 
                or Model:FindFirstChild("UpperTorso")
                
            if TargetPart then
                local ScreenPos, OnScreen = Camera:WorldToScreenPoint(TargetPart.Position)
                if OnScreen then
                    local Distance = (Vector2.new(ScreenPos.X, ScreenPos.Y) - FOVPos).Magnitude
                    if not AimLockSettings.OnlyInsideFOV or (Distance <= MaxDistance) then
                        if AimLockSettings.WallCheck then
                            local RayParams = RaycastParams.new()
                            RayParams.FilterType = RaycastFilterType.Exclude
                            local IgnoreList = {Camera}
                            if LocalPlayer.Character then table.insert(IgnoreList, LocalPlayer.Character) end
                            RayParams.FilterDescendantsInstances = IgnoreList
                            
                            local RayResult = workspace:Raycast(Camera.CFrame.Position, TargetPart.Position - Camera.CFrame.Position, RayParams)
                            if RayResult and RayResult.Instance and RayResult.Instance:IsDescendantOf(Model) then
                                MaxDistance = Distance
                                ClosestPart = TargetPart
                            end
                        else
                            MaxDistance = Distance
                            ClosestPart = TargetPart
                        end
                    end
                end
            end
        end
    end
    return ClosestPart
end

